{
  "name": "uarchdraw",
  "version": "0.1.0",
  "description": "Text to textbook-style microarchitecture diagrams. Explicit ports, traceable signals, editable SVG.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uarchdraw": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "assets/DejaVuSans.ttf",
    "assets/LICENSE_DEJAVU",
    "examples/",
    "docs/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "microarchitecture",
    "datapath",
    "risc-v",
    "diagram",
    "svg",
    "dsl"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "examples": "npm run build && node scripts/render-examples.mjs",
    "tutorials": "npm run build && node scripts/render-tutorials.mjs",
    "review": "npm run examples && node scripts/render-rv32i-details.mjs output/05-rv32i-forwarding",
    "review:arbiter": "npm run build && node scripts/review-arbiter.mjs",
    "review:cases": "npm run build && node scripts/review-cases.mjs",
    "review:automation": "npm run build && node scripts/review-automation.mjs",
    "review:all": "npm run build && node scripts/review-all.mjs",
    "branding": "npm run build && node scripts/render-branding.mjs",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "elkjs": "0.12.0",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/opentype.js": "1.3.8",
    "typescript": "5.9.3"
  }
}
